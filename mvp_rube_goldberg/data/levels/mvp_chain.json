{
  "meta": {
    "title": "MVP Chain",
    "objective": "Guide the balloon into the thorns",
    "description": "Full 7-pass physics chain: timer counts to 120, triggers gear which lifts gate via rope, ball falls and hits laser, laser powers fan which pushes balloon into thorns.",
    "hints": [
      "Wait for the timer to reach 120 ticks",
      "The gear activates the rope which lifts the gate",
      "The ball must hit the laser switch",
      "The fan pushes the balloon toward the thorns"
    ],
    "music": null
  },
  "physics": {
    "gravity_x": 0,
    "gravity_y": 8192,
    "air_pressure": 0
  },
  "chain_script": [
    {"when": {"type": "tick"}, "mode": "repeat", "actions": [
      {"type": "inc", "part": "Timer", "prop": "state_counter", "value": 1}
    ]},
    {"when": {"type": "prop_ge", "part": "Timer", "prop": "state_counter", "value": 120}, "mode": "once", "actions": [
      {"type": "log", "msg": "T=%.1fs Timer fires! Gear activates."},
      {"type": "set", "part": "Gear", "prop": "angular_velocity", "value": 8}
    ]},
    {"when": {"type": "prop_ge", "part": "Timer", "prop": "state_counter", "value": 120}, "mode": "repeat", "actions": [
      {"type": "set", "part": "Gear", "prop": "angular_velocity", "value": 8},
      {"type": "delta", "part": "Gate", "prop": "y", "value": 4}
    ]},
    {"when": {"type": "prop_gt_ref", "part": "Gate", "prop": "y", "ref_part": "Ball", "ref_prop": "pos_y", "offset": 10}, "mode": "once", "actions": [
      {"type": "log", "msg": "T=%.1fs Gate opens! Ball released."},
      {"type": "set_flag", "name": "ball_released", "value": true},
      {"type": "set", "part": "Ball", "prop": "is_moving", "value": true}
    ]},
    {"when": {"type": "and", "conditions": [
      {"type": "flag", "name": "ball_released", "value": true},
      {"type": "overlap", "a": "Ball", "b": "Laser"}
    ]}, "mode": "once", "actions": [
      {"type": "log", "msg": "T=%.1fs Laser hit! Fan ON. Balloon released."},
      {"type": "set", "part": "Laser", "prop": "state_counter", "value": 4},
      {"type": "set", "part": "Laser", "prop": "is_powered", "value": true},
      {"type": "set", "part": "Fan", "prop": "is_powered", "value": true},
      {"type": "set", "part": "Balloon", "prop": "is_moving", "value": true}
    ]},
    {"when": {"type": "prop_eq", "part": "Fan", "prop": "is_powered", "value": true}, "mode": "repeat", "actions": [
      {"type": "set", "part": "Fan", "prop": "state_counter", "value": 1}
    ]},
    {"when": {"type": "solution"}, "mode": "once", "actions": [
      {"type": "log", "msg": "Balloon reached thorns!"},
      {"type": "win"}
    ]}
  ],
